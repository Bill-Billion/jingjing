{
  "title": "祝福短视频（人工制作）",
  "description": "填写想送给谁、想表达什么及素材。平台人工受理、确认报价后制作并审片交付；无需填写AI提示词，不自动生成或扣费。时长、价格和交付日期以确认的报价与合同为准。",
  "fields": [
    {
      "key": "occasion",
      "label": "视频用途或场合",
      "type": "CHOICE",
      "required": true,
      "options": [
        "生日祝福",
        "婚礼祝福",
        "节日问候",
        "纪念与感谢",
        "企业祝福或口播",
        "其他"
      ]
    },
    {
      "key": "recipient",
      "label": "送给谁、如何称呼",
      "type": "TEXT",
      "required": true,
      "max_length": 200
    },
    {
      "key": "message",
      "label": "想说的话和需要表达的内容",
      "type": "TEXT",
      "required": true,
      "max_length": 4000
    },
    {
      "key": "use_scope",
      "label": "准备在哪里使用，是否用于商业宣传",
      "type": "TEXT",
      "required": true,
      "max_length": 1000
    },
    {
      "key": "performers",
      "label": "希望谁出镜或使用哪个已有数字人（需另行核验本人授权）",
      "type": "TEXT",
      "required": false,
      "max_length": 1000
    },
    {
      "key": "duration_wish",
      "label": "期望时长（由平台确认可行规格）",
      "type": "TEXT",
      "required": false,
      "max_length": 200
    },
    {
      "key": "deadline_wish",
      "label": "期望收到的日期（由平台确认交期）",
      "type": "TEXT",
      "required": false,
      "max_length": 200
    },
    {
      "key": "private_material",
      "label": "参考素材（仅在正式提交后供获准工作人员查看）",
      "type": "PRIVATE_ATTACHMENT",
      "required": false
    }
  ]
}
