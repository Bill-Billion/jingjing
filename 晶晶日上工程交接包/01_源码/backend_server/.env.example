# 晶晶日上后端环境变量（复制为 .env 并填入真实值）
NODE_ENV=development
PORT=3000

# JWT（生产环境必须修改，至少32位随机字符串）
JWT_SECRET=change_me_to_random_32_characters_minimum

# 数据库
DB_CLIENT=sqlite
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=jingjingshangri

# Redis（生产环境必填）
REDIS_URL=

# 微信支付（电商收付通）
WX_APPID=
WX_MCHID=
WX_SERIAL_NO=
WX_PRIVATE_KEY_PATH=./certs/apiclient_key.pem
WX_API_V3_KEY=
WX_NOTIFY_URL=https://api.jingjingshangri.com/api/payment/wx/notify
WX_ECOMMERCE_ENABLED=false

# 支付宝（旧直付通占位，保持关闭，本期不动）
ALIPAY_APPID=
ALIPAY_PRIVATE_KEY_PATH=./certs/alipay_private.pem
ALIPAY_PUBLIC_KEY_PATH=./certs/alipay_public.pem
ALIPAY_NOTIFY_URL=https://api.jingjingshangri.com/api/pay/alipay/notify
ALIPAY_DIRECT_ENABLED=false

# ===== 支付宝 APP 支付骨架（V12.4：services/alipay.js + routes/pay.js；密钥一到填这里即通）=====
# 总开关：密钥/证书未齐前必须 false（此时创建支付优雅返回「演示环境」，进程不崩溃）
ALIPAY_ENABLED=false
# 开放平台应用 APPID（16 位数字；区别于旧直付通 ALIPAY_APPID）
ALIPAY_APP_ID=
# 卖家 PID（2088 开头，可选，用于 seller_id 收款方）
ALIPAY_PID=
# 应用私钥：内联(PEM/单行base64) 或 文件路径，二选一；生产放 certs/ 用路径，勿入库
ALIPAY_PRIVATE_KEY=
# ALIPAY_PRIVATE_KEY_PATH=./certs/app_private.pem
# 支付宝公钥（公钥模式）：内联 或 文件路径，二选一；与下面证书模式三证书二选一
ALIPAY_PUBLIC_KEY=
# ALIPAY_PUBLIC_KEY_PATH=./certs/alipay_public.pem
# 证书模式三证书路径（公钥证书模式才填，普通公钥模式留空）
ALIPAY_APP_CERT_PATH=
ALIPAY_ALIPAY_CERT_PATH=
ALIPAY_ROOT_CERT_PATH=
# 网关：formal=正式 / sandbox=沙箱 / 也可直接填完整 gateway.do URL
ALIPAY_GATEWAY=sandbox

# 税务模式：none(无资质不代扣) | withholding(有委托代征资质)
TAX_MODE=none

# 敏感字段加密密钥（32字节）
FIELD_ENC_KEY=change_me_32_bytes_field_enc_key

# OSS
OSS_ENABLED=false
OSS_REGION=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# CORS
CORS_ORIGIN=http://localhost:8080,http://localhost:3000

# ===== Volcengine (Ark) - fill real values in local .env, never commit =====
VOLC_ACCESS_KEY_ID=
VOLC_SECRET_ACCESS_KEY=
VOLC_REGION=cn-beijing
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_LLM_MODEL=
ARK_T2V_MODEL=
ARK_T2I_MODEL=
ARK_TTS_MODEL=seed-tts-2.0
ARK_VOICE_CLONE_MODEL=seed-icl-2.0
VOLC_VOICE_ID=
ARK_TTS_SPEAKER=zh_female_vv_uranus_bigtts
SPEECH_API_KEY=
SPEECH_APP_ID=

# ===== 火山短信 SMS（复用上面的 VOLC_ACCESS_KEY_ID / VOLC_SECRET_ACCESS_KEY 做 V4 签名）=====
# 签名+验证码模板在「短信服务→国内短信」审核通过后回填，再把 SMS_ENABLED 置 true
SMS_ENABLED=false
SMS_REGION=cn-north-1
SMS_HOST=sms.volcengineapi.com
SMS_ACCOUNT=
SMS_SIGN_NAME=
SMS_LOGIN_TEMPLATE_ID=
# 仅开发/演示兜底固定验证码；生产环境(NODE_ENV=production)强制失效，留空即关闭
SMS_DEV_CODE=

# ===== AI 上游治理（可选）=====
AI_DAILY_COST_CAP_FEN=20000
AI_RETRY_MAX=2
# AI 生成接口默认必须登录；仅本地联调可置 true 放行匿名调用，线上严禁开启
ALLOW_ANON_AI=false

# ===== V13 工程化整改新增（全部可选，缺省安全降级，不含任何真实密钥）=====
# 存储：默认本地 uploads；OSS_ENABLED=true 且四要素齐全才上 OSS，缺凭证自动降级本地
OSS_ENABLED=false
OSS_REGION=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=
OSS_CDN_BASE=
# 未来切 MySQL（决策见 migrations/mysql/README_mysql_switch.md）
DB_CLIENT=sqlite
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=jingjingshangri
# AI 交付审核：默认 false=成片即可交付（现状）；true=先 pending_review，本地预审+人工放行
AI_DELIVERABLE_REVIEW=false
# 方舟异步回调 HMAC 验签密钥；留空则回退用 ARK_API_KEY
ARK_WEBHOOK_SECRET=
# 告警外发机器人 webhook（钉钉/飞书/企微）；留空只写结构化日志不外发
ALERT_WEBHOOK_URL=
# Apple 应用内购买（iOS 数字商品必需）服务端校验
APPLE_IAP_SHARED_SECRET=
APPLE_BUNDLE_ID=

# ===== 阿里云 实人认证 + 内容安全2.0（V12.5；缺任一凭证自动安全降级，不填不影响现有功能）=====
# RAM 子账号 AccessKey（建议仅授予 AliyunCloudauthFullAccess + AliyunYundunGreenFullAccess 最小权限）
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_REGION=cn-shanghai
# 实人认证 cloudauth：控制台「实人认证→认证方案」创建后得到的数值型场景ID（要素核验/人脸核身各一个）
CLOUDAUTH_ENDPOINT=cloudauth.aliyuncs.com
CLOUDAUTH_REGION=cn-shanghai
CLOUDAUTH_ELEMENT_SCENE_ID=
CLOUDAUTH_FACE_SCENE_ID=
# 人脸核身相似度通过阈值（0-100，默认80）
CLOUDAUTH_FACE_PASS_SCORE=80
# 内容安全2.0 green：service 场景名以控制台已开通为准（可按实际开通场景覆盖）
GREEN_ENDPOINT=green-cip.cn-shanghai.aliyuncs.com
GREEN_REGION=cn-shanghai
GREEN_TEXT_SERVICE=comment_detection
GREEN_IMAGE_SERVICE=baselineCheck
GREEN_VIDEO_SERVICE=videoDetection
# 云机审总开关：有 ALIYUN AK 即用云；如要强制走本地词库+人工，把 MODERATION_ENABLED 设为 false
MODERATION_ENABLED=true
# 兼容旧键（一般不用，优先 ALIYUN_ACCESS_KEY_*）：MODERATION_PROVIDER=aliyun / MODERATION_API_KEY / MODERATION_API_SECRET

# ===== V12.6 火山引擎合规三件套（实名二要素/人脸核身/文图视频机审；缺任一要素自动安全降级，不崩不伪造）=====
# 合规供应商总开关：默认 volc（火山）；置 aliyun 即一键切回上面的阿里云 V12.5 备用实现（实现完整保留）
COMPLIANCE_PROVIDER=volc
# IAM 专用子用户 jjsr-compliance（仅编程访问，仅授 CVFullAccess + BusinessSecurityFullAccess）
# 变量名固定如下；SK 为 60 位 base64 新格式属正常，勿截断。本地真实值放 secrets/volc/compliance.env，勿提交、勿入日志
VOLC_COMPLIANCE_ENABLED=true
VOLC_COMPLIANCE_ACCESS_KEY_ID=
VOLC_COMPLIANCE_SECRET_ACCESS_KEY=
VOLC_COMPLIANCE_REGION=cn-north-1
# 视觉智能 visual 人脸核身（cv / CertSrcFaceComp，已可联调；host 一般无需改）
VOLC_VISUAL_HOST=visual.volcengineapi.com
# 人脸相似度通过线（官方阈值口径 1e-4，一般无需改）
VOLC_FACE_PASS_SCORE=0.0001
# 业务安全 rms（实名二要素 + 内容风险识别）——人工审批中，下列 AppID/bizType 审批下发后再填；缺则相关能力 ready=false
VOLC_RMS_HOST=
VOLC_RMS_APP_ID=
VOLC_RMS_ID_VERIFY_BIZ_TYPE=
VOLC_RMS_TEXT_BIZ_TYPE=
VOLC_RMS_IMAGE_BIZ_TYPE=
VOLC_RMS_VIDEO_BIZ_TYPE=
