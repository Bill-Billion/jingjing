# Local example only. Fill secrets outside Git, or use the workspace local-mysql helper.
NODE_ENV=development
DB_CLIENT=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=33316
MYSQL_USER=jx_local
MYSQL_PASSWORD=
MYSQL_DATABASE=jx_dev
MYSQL_CONNECTION_LIMIT=4
MYSQL_CONNECT_TIMEOUT_MS=5000
MYSQL_SSL_MODE=disabled
# Production requires NODE_ENV=production, MYSQL_SSL_MODE=verify_identity,
# MYSQL_SSL_CA=<trusted CA file>, non-root user and explicit target credentials.
