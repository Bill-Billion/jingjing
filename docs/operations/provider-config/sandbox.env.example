# 新版测试环境模板；复制到.local后填写。空项必须补齐，不能直接启动。
# 密钥不能入Git；资料齐全不等于外部服务已验证。
# 模型和语音栏目供接入准备，不能靠这些字段启用新版数字人。

# 服务器和MySQL
NODE_ENV=test
DB_CLIENT=mysql
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
MYSQL_SSL_MODE=disabled
AUTH_SECRET_BASE64=
API_ALLOWED_ORIGINS=
# 正式环境必须单独配置TLS证书和非root账号。
MYSQL_SSL_CA=

# 短信登录
SMS_ENABLED=false
VOLC_ACCESS_KEY_ID=
VOLC_SECRET_ACCESS_KEY=
SMS_ACCOUNT=
SMS_SIGN_NAME=
SMS_LOGIN_TEMPLATE_ID=
SMS_CONFIG_REVISION=

# 私有文件存储（OSS）
OSS_REGION=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENVIRONMENT=SANDBOX
# 新版不读取OSS_ENABLED，调用仍受数据库服务验证记录控制。
OSS_ENDPOINT=

# 支付宝
TRADE_ALIPAY_ENABLED=false
TRADE_ALIPAY_APP_ID=
TRADE_ALIPAY_MERCHANT_ID=
TRADE_ALIPAY_MERCHANT_PARTY_ID=
TRADE_ALIPAY_PRIVATE_KEY=
TRADE_ALIPAY_PUBLIC_KEY=
TRADE_ALIPAY_NOTIFY_URL=
TRADE_ALIPAY_CONFIG_REVISION=

# Apple购买
TRADE_APPLE_ENABLED=false
TRADE_APPLE_BUNDLE_ID=
TRADE_APPLE_APP_APPLE_ID=
TRADE_APPLE_MERCHANT_PARTY_ID=
TRADE_APPLE_PRIVATE_KEY=
TRADE_APPLE_KEY_ID=
TRADE_APPLE_ISSUER_ID=
TRADE_APPLE_ROOT_CERT_PATHS=
TRADE_APPLE_CONFIG_REVISION=

# 模型和数字人（还需新版接入实现）
ARK_API_KEY=
ARK_LLM_MODEL=
ARK_T2I_MODEL=
ARK_T2V_MODEL=

# 语音（还需新版接入实现）
SPEECH_API_KEY=
SPEECH_APP_ID=
SPEECH_VOICE_ID=
