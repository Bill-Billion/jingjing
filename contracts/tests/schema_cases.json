{
  "description": "Negative protocol payloads. These are schema tests, not runtime authorization or Provider tests.",
  "cases": [
    {
      "name": "fractional minor units rejected",
      "schema": "Money",
      "value": {
        "amount_minor": 1.25,
        "currency": "CNY"
      }
    },
    {
      "name": "negative transaction price rejected",
      "schema": "Money",
      "value": {
        "amount_minor": -1,
        "currency": "CNY"
      }
    },
    {
      "name": "unsafe JavaScript integer rejected",
      "schema": "Money",
      "value": {
        "amount_minor": 9007199254740992,
        "currency": "CNY"
      }
    },
    {
      "name": "string amount rejected",
      "schema": "Money",
      "value": {
        "amount_minor": "100",
        "currency": "CNY"
      }
    },
    {
      "name": "currency required",
      "schema": "Money",
      "value": {
        "amount_minor": 100
      }
    },
    {
      "name": "lowercase currency rejected",
      "schema": "Money",
      "value": {
        "amount_minor": 100,
        "currency": "cny"
      }
    },
    {
      "name": "client may not choose actor",
      "schema": "PartyPatch",
      "value": {
        "display_name": "Synthetic",
        "actor": {
          "account_id": "someone_else"
        }
      }
    },
    {
      "name": "profile patch cannot grant MCN capability",
      "schema": "PartyPatch",
      "value": {
        "display_name": "Synthetic",
        "capabilities": [
          {
            "code": "MCN",
            "current_status": "ACTIVE"
          }
        ]
      }
    },
    {
      "name": "empty profile mutation rejected",
      "schema": "PartyPatch",
      "value": {}
    },
    {
      "name": "login cannot supply verified flag",
      "schema": "SessionRequest",
      "value": {
        "challenge_id": "test_challenge",
        "phone": "13800000000",
        "code": "000000",
        "verified": true
      }
    },
    {
      "name": "non numeric login code rejected",
      "schema": "SessionRequest",
      "value": {
        "challenge_id": "test_challenge",
        "phone": "13800000000",
        "code": "abcdef"
      }
    },
    {
      "name": "login challenge required",
      "schema": "SessionRequest",
      "value": {
        "phone": "13800000000",
        "code": "000000"
      }
    },
    {
      "name": "auto approval is not a real identity status",
      "schema": "IdentityVerification",
      "value": {
        "current_status": "unverified_auto",
        "verification_id": null,
        "verified_at": null,
        "allowed_actions": []
      }
    },
    {
      "name": "verified identity needs evidence and time",
      "schema": "IdentityVerification",
      "value": {
        "current_status": "VERIFIED",
        "verification_id": null,
        "verified_at": null,
        "allowed_actions": []
      }
    },
    {
      "name": "disabled business capability cannot grant actions",
      "schema": "BusinessCapability",
      "value": {
        "code": "payment.create",
        "availability": "NOT_ENABLED",
        "reason_code": "PROVIDER_NOT_READY",
        "display_message": "未启用",
        "allowed_actions": [
          "payment.create"
        ]
      }
    },
    {
      "name": "disabled capability explains reason",
      "schema": "BusinessCapability",
      "value": {
        "code": "payment.create",
        "availability": "NOT_ENABLED",
        "reason_code": null,
        "display_message": "未启用",
        "allowed_actions": []
      }
    },
    {
      "name": "immutable snapshot version cannot increment",
      "fixture": "ContractSnapshotResponse",
      "mutate_path": [
        "data",
        "object_version"
      ],
      "replace_with": 2
    },
    {
      "name": "signature claim requires evidence refs",
      "fixture": "ContractSnapshotResponse",
      "mutate_path": [
        "data",
        "signing_method"
      ],
      "replace_with": "PLATFORM_ESIGN"
    },
    {
      "name": "production readiness cannot use sandbox proof",
      "fixture": "ProviderReadinessPageResponse",
      "mutate_path": [
        "data",
        "items",
        0,
        "current_status"
      ],
      "replace_with": "PRODUCTION_VERIFIED"
    },
    {
      "name": "effective rule needs effective time",
      "fixture": "RuleVersionResponse",
      "mutate_path": [
        "data",
        "effective_at"
      ],
      "replace_with": null
    },
    {
      "name": "malformed UTC timestamp rejected",
      "fixture": "ContractSnapshotResponse",
      "mutate_path": [
        "data",
        "created_at"
      ],
      "replace_with": "yesterday"
    },
    {
      "name": "unknown provider state rejected",
      "fixture": "ProviderReadinessPageResponse",
      "mutate_path": [
        "data",
        "items",
        0,
        "current_status"
      ],
      "replace_with": "SUCCESS"
    },
    {
      "name": "request correlation is required",
      "fixture": "ErrorResponse",
      "remove_path": [
        "meta",
        "request_id"
      ]
    },
    {
      "name": "unsigned inline snapshot cannot claim signed",
      "fixture": "UnsignedSnapshotContentResponse",
      "mutate_path": [
        "data",
        "signing_method"
      ],
      "replace_with": "PLATFORM_ESIGN"
    },
    {
      "name": "inline snapshot needs historical rules",
      "fixture": "UnsignedSnapshotContentResponse",
      "mutate_path": [
        "data",
        "rule_contents"
      ],
      "replace_with": []
    },
    {
      "name": "historical rule hash required",
      "fixture": "RuleContentResponse",
      "remove_path": [
        "data",
        "content_sha256"
      ]
    },
    {
      "name": "inline content cannot fabricate a file asset",
      "fixture": "UnsignedSnapshotContentResponse",
      "mutate_path": [
        "data",
        "content_asset_id"
      ],
      "replace_with": "fake_asset"
    },
    {
      "name": "ready cannot retain failure reason",
      "schema": "BusinessServiceReadiness",
      "value": {
        "action": "START_PAYMENT",
        "environment": "SANDBOX",
