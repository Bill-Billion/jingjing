      "fixture": "SupplyAssetResponse",
      "mutate_path": [
        "data",
        "current_status"
      ],
      "replace_with": "UPLOADING"
    },
    {
      "name": "private object keys must not be returned",
      "fixture": "SupplyAssetResponse",
      "mutate_path": [
        "data",
        "object_key"
      ],
      "replace_with": "private/hidden"
    },
    {
      "name": "supply cannot create a license",
      "fixture": "SupplyRecordResponse",
      "mutate_path": [
        "data",
        "kind"
      ],
      "replace_with": "AUTO_LICENSE"
