    },
    {
      "name": "signed is not a service readiness status",
      "schema": "BusinessServiceReadiness",
      "value": {
        "action": "START_PAYMENT",
        "environment": "SANDBOX",
        "current_status": "SIGNED",
        "reason_code": "PROVIDER_NOT_IMPLEMENTED"
      }
    },
    {
      "name": "unknown business action rejected",
      "schema": "BusinessServiceReadiness",
      "value": {
        "action": "AUTO_APPROVE",
        "environment": "SANDBOX",
        "current_status": "NOT_ENABLED",
        "reason_code": "PROVIDER_NOT_IMPLEMENTED"
      }
